{
  "name": "niceservbay",
  "private": true,
  "version": "2.0.10",
  "description": "NiceEnv — local development environment manager (Go + Wails v3 + React)",
  "scripts": {
    "check:wails-port": "node scripts/wails-port-status.mjs",
    "dev": "pnpm --filter @nsb/web dev",
    "build:web": "pnpm --filter @nsb/web build",
    "check:go": "go vet ./...",
    "compile:desktop": "go build -tags desktopassets -o NiceEnv-Wails.exe ./cmd/niceenv",
    "package:desktop": "node scripts/package-desktop.mjs",
    "check": "pnpm -r run check"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
