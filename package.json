{
  "name": "niceservbay",
  "private": true,
  "version": "0.1.0",
  "description": "NiceEnv — one-stop local dev environment manager (Tauri 2 + Next.js)",
  "scripts": {
    "dev": "pnpm --filter @nsb/web dev",
    "build:web": "pnpm --filter @nsb/web build",
    "tauri": "pnpm --filter @nsb/desktop tauri",
    "check": "pnpm -r run check"
  },
  "engines": {
    "node": ">=20"
  }
}
