{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiceServBay",
  "version": "0.1.0",
  "identifier": "com.niceservbay.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @nsb/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @nsb/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "NiceServBay",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "NiceServBay — 本地开发环境"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
